<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raiz" fx:controller="com.fgsistemas.pos.controller.LoginController">

    <!-- Tarjeta centrada vertical y horizontalmente -->
    <VBox styleClass="tarjeta, tarjeta-login" spacing="8" alignment="CENTER_LEFT" maxHeight="-Infinity">
        <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="imgLogo" fitHeight="72" fitWidth="200" preserveRatio="true"
                       visible="false" managed="false"/>
            <StackPane fx:id="logoGenerico" styleClass="logo-generico">
                <Label text="PV" styleClass="logo-generico-texto"/>
            </StackPane>
            <Label fx:id="lblNegocio" styleClass="titulo" wrapText="true" textAlignment="CENTER"/>
            <Label text="Inicia sesión para continuar" styleClass="texto-secundario"/>
            <padding>
                <Insets bottom="12"/>
            </padding>
        </VBox>

        <Label text="Usuario"/>
        <TextField fx:id="txtUsuario"/>
        <Label text="Contraseña">
            <padding>
                <Insets top="8"/>
            </padding>
        </Label>
        <PasswordField fx:id="txtPassword"/>
        <Label fx:id="lblError" styleClass="texto-error" wrapText="true" minHeight="22"/>
        <Button fx:id="btnEntrar" text="Entrar" maxWidth="Infinity" onAction="#entrar"/>
    </VBox>

    <!-- Pie: fecha/hora y versión -->
    <Label fx:id="lblPie" styleClass="texto-pequeno" StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets bottom="20"/>
        </StackPane.margin>
    </Label>

    <Button fx:id="btnSalir" text="Salir" styleClass="boton-secundario" onAction="#salir"
            StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="16" right="20"/>
        </StackPane.margin>
    </Button>
</StackPane>

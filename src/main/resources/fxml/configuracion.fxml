<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<!-- Configuración (22-configuracion.md) y respaldos (23-respaldos.md). Solo admin.
     El contenido de cada pestaña se arma en ConfiguracionController. -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="raiz" fx:controller="com.fgsistemas.pos.controller.ConfiguracionController">
    <top>
        <fx:include fx:id="barraSuperior" source="barra-superior.fxml"/>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="24" right="32" bottom="16" left="32"/>
            </padding>
            <Label text="Configuración" styleClass="titulo"/>
            <Label text="Ctrl+Tab cambia de pestaña · Ctrl+S guarda todas las pestañas · Esc regresa al menú"
                   styleClass="texto-secundario"/>
            <TabPane fx:id="pestanas" tabClosingPolicy="UNAVAILABLE" focusTraversable="false" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>

    <bottom>
        <FlowPane fx:id="barraAcciones" styleClass="barra-acciones"/>
    </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raiz" fx:controller="com.fgsistemas.pos.controller.BienvenidaController">

    <VBox alignment="CENTER" spacing="20" maxWidth="420" maxHeight="-Infinity">

        <HBox fx:id="indicador" styleClass="indicador-pasos" alignment="CENTER" spacing="10">
            <Label fx:id="punto1" text="●"/>
            <Label fx:id="punto2" text="○"/>
            <Label fx:id="punto3" text="○"/>
        </HBox>

        <StackPane>
            <!-- Paso 1: bienvenida -->
            <VBox fx:id="paso1" styleClass="tarjeta, tarjeta-login" spacing="16" alignment="CENTER">
                <StackPane styleClass="logo-generico">
                    <Label text="PV" styleClass="logo-generico-texto"/>
                </StackPane>
                <Label text="¡Bienvenido a tu Punto de Venta!" styleClass="subtitulo" wrapText="true"/>
                <Label text="Vamos a configurar tu sistema en 2 pasos." styleClass="texto-secundario"
                       wrapText="true"/>
                <Button fx:id="btnComenzar" text="Comenzar" maxWidth="Infinity" onAction="#comenzar"/>
            </VBox>

            <!-- Paso 2: administrador -->
            <VBox fx:id="paso2" styleClass="tarjeta, tarjeta-login" spacing="6" visible="false" managed="false">
                <Label text="Crea tu usuario administrador" styleClass="subtitulo" wrapText="true"/>
                <Label text="Con este usuario controlarás todo el sistema." styleClass="texto-secundario"
                       wrapText="true"/>

                <Label text="Nombre completo"/>
                <TextField fx:id="txtNombre" promptText="Ej. María López"/>
                <Label fx:id="errNombre" styleClass="texto-error"/>

                <Label text="Usuario"/>
                <TextField fx:id="txtUsuario" promptText="minúsculas, sin espacios (3 a 20)"/>
                <Label fx:id="errUsuario" styleClass="texto-error"/>

                <Label text="Contraseña"/>
                <PasswordField fx:id="txtPassword" promptText="mínimo 6 caracteres"/>
                <Label fx:id="errPassword" styleClass="texto-error"/>

                <Label text="Confirmar contraseña"/>
                <PasswordField fx:id="txtConfirmar"/>
                <Label fx:id="errConfirmar" styleClass="texto-error"/>

                <Button fx:id="btnSiguiente" text="Siguiente" maxWidth="Infinity" onAction="#siguiente"/>
                <Button text="Atrás (Esc)" styleClass="boton-secundario" maxWidth="Infinity"
                        focusTraversable="false" onAction="#atras"/>
            </VBox>

            <!-- Paso 3: negocio -->
            <VBox fx:id="paso3" styleClass="tarjeta, tarjeta-login" spacing="6" visible="false" managed="false">
                <Label text="Datos de tu negocio" styleClass="subtitulo"/>
                <Label text="Aparecerán en la pantalla de inicio y en tus reportes." styleClass="texto-secundario"
                       wrapText="true"/>

                <Label text="Nombre del negocio"/>
                <TextField fx:id="txtNegocio" promptText="Ej. Abarrotes La Esperanza"/>
                <Label fx:id="errNegocio" styleClass="texto-error"/>

                <Label text="Teléfono (opcional)"/>
                <TextField fx:id="txtTelefono"/>
                <Label text=" " styleClass="texto-error"/>

                <Label text="Dirección (opcional)"/>
                <TextField fx:id="txtDireccion"/>
                <Label text=" " styleClass="texto-error"/>

                <Button fx:id="btnTerminar" text="Terminar" maxWidth="Infinity" onAction="#terminar"/>
                <Button text="Atrás (Esc)" styleClass="boton-secundario" maxWidth="Infinity"
                        focusTraversable="false" onAction="#atras"/>
            </VBox>
        </StackPane>
    </VBox>
</StackPane>
